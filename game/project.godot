; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Langame"
config/description="Speech-first German-learning cozy RPG."
run/main_scene="res://scenes/world/farm.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

ContentDB="*res://scripts/language/content_db.gd"
Config="*res://scripts/language/config.gd"
WordStats="*res://scripts/language/word_stats.gd"
Mastery="*res://scripts/language/mastery.gd"
Scheduler="*res://scripts/language/scheduler.gd"
TemplateBinder="*res://scripts/quests/template_binder.gd"
DrillSpawner="*res://scripts/quests/drill_spawner.gd"
MicCapture="*res://scripts/speech/mic_capture.gd"
SpeechService="*res://scripts/speech/speech_service.gd"
GameState="*res://scripts/core/game_state.gd"
WorldRouter="*res://scripts/core/world_router.gd"
Quests="*res://scripts/quests/quest_engine.gd"
Dialogue="*res://scenes/ui/dialogue_runner.tscn"
Phone="*res://scenes/ui/phone/phone.tscn"
HUD="*res://scenes/ui/game_hud.tscn"
DayCycle="*res://scripts/core/day_cycle.gd"
SaveService="*res://scripts/core/save_service.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[importer_defaults]

texture={
"compress/mode": 0,
"detect_3d/compress_to": 0,
"mipmaps/generate": false,
"process/fix_alpha_border": true
}

